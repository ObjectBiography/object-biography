---
layout: base.njk
eleventyExcludeFromCollections: true
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag.slug }}/"
eleventyComputed:
  title: "{{ tag.name }}"
  description: "Objects and essays tagged {{ tag.name }}."
---
<a class="back-link" href="/tags/">&larr; All Tags</a>
<h1>{{ tag.name }}</h1>
<div class="gallery-grid">
  {% for item in tag.items | reverse %}
    <a class="gallery-item" href="{{ item.url }}">
      <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy">
      <span>{{ item.data.title }}</span>
    </a>
  {% endfor %}
</div>
<p class="grid-count">{{ tag.items.length }} item{% if tag.items.length != 1 %}s{% endif %} tagged {{ tag.name }} — that's all of them</p>
