---
layout: base.njk
title: Objects
description: Browse the full gallery of objects, each with its own story.
eleventyExcludeFromCollections: true
---
{% if collections.objectFilters.length %}
<div class="filter-bar">
  <button class="filter-btn is-active" data-filter="all">All</button>
  {% for pill in collections.objectFilters %}
    <button class="filter-btn" data-filter="{{ pill.slug }}">{{ pill.name }}</button>
  {% endfor %}
</div>
{% endif %}

<div class="gallery-grid" id="object-grid">
  {% for item in collections.objects | reverse %}
    <a class="gallery-item"
       href="{{ item.url }}"
       data-categories="{% for cat in item.data.category %}{{ cat | slugify }}{% if not loop.last %} {% endif %}{% endfor %}{% if item.data.tags %} {% for tag in item.data.tags %}{% if tag != "objects" and tag != "essays" %}{{ tag | slugify }}{% if not loop.last %} {% endif %}{% endif %}{% endfor %}{% endif %}">
      <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy">
      <span>{{ item.data.title }}</span>
    </a>
  {% endfor %}
</div>
<p class="grid-count" id="grid-count">{{ collections.objects.length }} object{% if collections.objects.length != 1 %}s{% endif %} — that's all of them</p>

{% if collections.objectFilters.length %}
<script>
  (function () {
    var buttons = document.querySelectorAll(".filter-btn");
    var items = document.querySelectorAll("#object-grid .gallery-item");
    var count = document.getElementById("grid-count");
    var total = items.length;

    function updateCount(filter, shown) {
      if (!count) return;
      if (filter === "all") {
        count.textContent = total + " object" + (total !== 1 ? "s" : "") + " — that's all of them";
      } else {
        count.textContent = "Showing " + shown + " of " + total + " objects";
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        buttons.forEach(function (b) { b.classList.remove("is-active"); });
        btn.classList.add("is-active");

        var filter = btn.getAttribute("data-filter");
        var shown = 0;
        items.forEach(function (item) {
          var cats = (item.getAttribute("data-categories") || "").split(" ");
          var matches = filter === "all" || cats.indexOf(filter) !== -1;
          item.style.display = matches ? "" : "none";
          if (matches) shown++;
        });
        updateCount(filter, shown);
      });
    });
  })();
</script>
{% endif %}
