---
layout: base.njk
eleventyExcludeFromCollections: true
pagination:
  data: collections.branchCategories
  size: 1
  alias: cat
permalink: "/objects/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.name | safe }} Militaria"
  description: "{{ cat.name | safe }} militaria in the Object Biography collection, each with its documented history."
---
<a class="back-link" href="/objects/">&larr; All Objects</a>
<h1>{{ cat.name }}</h1>
<div class="gallery-grid">
  {% for item in cat.items | reverse %}
    <a class="gallery-item" href="{{ item.url }}">
      <img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy">
      <span>{{ item.data.title }}</span>
    </a>
  {% endfor %}
</div>
