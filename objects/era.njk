---
layout: base.njk
eleventyExcludeFromCollections: true
pagination:
  data: collections.eraPages
  size: 1
  alias: era
permalink: "/objects/{{ era.slug }}/"
eleventyComputed:
  title: "{% if era.longName %}{{ era.longName | safe }} ({{ era.name | safe }}){% else %}{{ era.name | safe }}{% endif %} Militaria"
  description: "{{ era.metaDescription }}"
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/objects/">Objects</a> <span aria-hidden="true">&rsaquo;</span> <span>{{ era.name }}</span>
</nav>
<h1>{% if era.longName %}{{ era.longName }} ({{ era.name }}){% else %}{{ era.name }}{% endif %}</h1>

<div class="era-intro">
  {% for para in era.intro %}<p>{{ para }}</p>{% endfor %}
</div>

<ul class="era-list">
  {% for item in era.items %}
  <li class="era-item">
    <a class="era-thumb" href="{{ item.url }}"><img src="{{ item.data.thumbnail }}" alt="{{ item.data.title }}" loading="lazy"></a>
    <div class="era-text">
      <h2><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
      <p>{{ item.data.description }}</p>
    </div>
  </li>
  {% endfor %}
</ul>

<nav class="era-nav" aria-label="Other eras">
  <span>Other eras:</span>
  {% for other in collections.eraPages %}{% if other.slug != era.slug %}
  <a href="/objects/{{ other.slug }}/">{{ other.name }}</a>
  {% endif %}{% endfor %}
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": {{ title | dump | safe }},
      "description": {{ era.metaDescription | dump | safe }},
      "url": "{{ site.url }}{{ page.url }}",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [{% for item in era.items %}
          {"@type": "ListItem", "position": {{ loop.index }}, "url": "{{ site.url }}{{ item.url }}", "name": {{ item.data.title | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Objects", "item": "{{ site.url }}/objects/"},
        {"@type": "ListItem", "position": 2, "name": {{ era.name | dump | safe }}, "item": "{{ site.url }}{{ page.url }}"}
      ]
    }
  ]
}
</script>
